# Copie para .env e preencha (nunca commite .env)
#
# API keys
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
#
# Fallback (especialistas sem variável específica)
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-6
#
# Arquitetura oficial v1 — TASK-006
# Camada estratégica: padrão Ronaldo (OpenAI) — orquestração usa o modelo forte
MAESTRO_PROVIDER=openai
MAESTRO_MODEL=gpt-5
#
# Voz do Painel Maestro (resposta rápida, NÃO afeta a orquestração estratégica)
# Comandos conhecidos são respondidos sem LLM; comandos livres usam este modelo:
VOICE_LLM_MODEL=gpt-4o-mini
# Cache do snapshot operacional (segundos) — reduz latência da voz
MAESTRO_SNAPSHOT_TTL=8
#
# Ferramentas dos agentes (CRM, tasks, memória, WhatsApp). 0 desliga tudo.
TOOLS_ENABLED=1
# Memória nativa do CrewAI na orquestração (requer embedder/API key). 0 = off.
CREW_MEMORY=0
# Roteamento por custo (litellm provider/model) — tarefas simples vs fortes
# TIER_SIMPLE_MODEL=anthropic/claude-haiku-4-5-20251001
# TIER_STRONG_MODEL=anthropic/claude-opus-4-8
#
# Revisão automática das respostas do Caio antes do envio. 0 = off.
CAIO_REVIEW=1
# Modelo do revisor (barato/rápido)
REVIEW_LLM_MODEL=gpt-4o-mini
#
# TTS Ronaldo (OpenAI) — tts-1 tem menor latência (conversa fluida)
TTS_MODEL=tts-1
TTS_VOICE=onyx
TTS_SPEED=1.05
#
# Especialistas (Anthropic Sonnet)
CAIO_PROVIDER=anthropic
CAIO_MODEL=claude-sonnet-4-6
#
JUAREZ_PROVIDER=anthropic
JUAREZ_MODEL=claude-sonnet-4-6
#
DEV_PROVIDER=anthropic
DEV_MODEL=claude-sonnet-4-6
#
DONIZETE_PROVIDER=anthropic
DONIZETE_MODEL=claude-sonnet-4-6
#
# Loide — UX Designer (experiência de uso); colabora com o Dev
LOIDE_PROVIDER=anthropic
LOIDE_MODEL=claude-sonnet-4-6
#
# WhatsApp Business Cloud API — TASK-007
# Meta Developers → App → WhatsApp → API Setup
# IMPORTANTE: preencha estes valores SOMENTE no seu .env local (nunca neste arquivo).
WHATSAPP_VERIFY_TOKEN=seu_token_de_verificacao
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Opcional: validação X-Hub-Signature-256 (recomendado em produção)
META_APP_SECRET=seu_app_secret_da_meta
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_PORT=8000
# WHATSAPP_HOST=127.0.0.1   # produção VPS (nginx na frente)
