# Copie para .env e preencha (nunca commite .env)
#
# API keys
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
#
# Fallback (especialistas sem variável específica)
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-6
#
# Arquitetura oficial v1 — TASK-006
# Camada estratégica: padrão Ronaldo (OpenAI) — orquestração usa o modelo forte
MAESTRO_PROVIDER=openai
MAESTRO_MODEL=gpt-5
#
# Voz do Painel Maestro (resposta rápida, NÃO afeta a orquestração estratégica)
# Comandos conhecidos são respondidos sem LLM; comandos livres usam este modelo:
VOICE_LLM_MODEL=gpt-4o-mini
# Cache do snapshot operacional (segundos) — reduz latência da voz
MAESTRO_SNAPSHOT_TTL=8
#
# Ferramentas dos agentes (CRM, tasks, memória, WhatsApp). 0 desliga tudo.
TOOLS_ENABLED=1
# Memória nativa do CrewAI na orquestração (requer embedder/API key). 0 = off.
CREW_MEMORY=0
#
# Tetos de segurança dos agentes (impedem travamento; NÃO são alvos).
# Folgados para a orquestração concluir; aperte estes valores p/ controlar custo.
LLM_TIMEOUT=300            # timeout por chamada de LLM (segundos)
AGENT_MAX_ITER=25          # máx. de iterações de raciocínio por agente
AGENT_MAX_EXECUTION_TIME=600  # tempo máx. por agente (segundos)
# AGENT_MAX_RPM=            # limite de req/min por agente (vazio = sem limite)
# CREW_MAX_RPM=             # limite de req/min da crew inteira (vazio = sem limite)
#
# Piloto automático — dá sequência às TASKs em execução sem intervenção.
# LIGADO por padrão. Para controlar custo: aumente o intervalo/cooldown,
# reduza MAX_TASKS, ou desligue com AUTOPILOT_ENABLED=0.
AUTOPILOT_ENABLED=1
AUTOPILOT_INTERVAL_S=600   # acorda a cada 10 min (ritmo equilibrado)
AUTOPILOT_MAX_TASKS=1      # 1 tarefa por ciclo (foco + economia)
AUTOPILOT_COOLDOWN_S=1800  # não repete a mesma TASK antes de 30 min (alterna)
# Roteamento por custo (litellm provider/model) — tarefas simples vs fortes
# TIER_SIMPLE_MODEL=anthropic/claude-haiku-4-5-20251001
# TIER_STRONG_MODEL=anthropic/claude-opus-4-8
#
# Revisão automática das respostas do Caio antes do envio. 0 = off.
CAIO_REVIEW=1
# Modelo do revisor (barato/rápido)
REVIEW_LLM_MODEL=gpt-4o-mini
#
# TTS Ronaldo (OpenAI) — tts-1 tem menor latência (conversa fluida)
TTS_MODEL=tts-1
TTS_VOICE=onyx
TTS_SPEED=1.05
#
# Especialistas (Anthropic Sonnet)
CAIO_PROVIDER=anthropic
CAIO_MODEL=claude-sonnet-4-6
#
JUAREZ_PROVIDER=anthropic
JUAREZ_MODEL=claude-sonnet-4-6
#
DEV_PROVIDER=anthropic
DEV_MODEL=claude-sonnet-4-6
#
DONIZETE_PROVIDER=anthropic
DONIZETE_MODEL=claude-sonnet-4-6
#
# Loide — UX Designer (experiência de uso); colabora com o Dev
LOIDE_PROVIDER=anthropic
LOIDE_MODEL=claude-sonnet-4-6
#
# WhatsApp Business Cloud API — TASK-007
# Meta Developers → App → WhatsApp → API Setup
# IMPORTANTE: preencha estes valores SOMENTE no seu .env local (nunca neste arquivo).
WHATSAPP_VERIFY_TOKEN=seu_token_de_verificacao
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Opcional: validação X-Hub-Signature-256 (recomendado em produção)
META_APP_SECRET=seu_app_secret_da_meta
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_PORT=8000
# WHATSAPP_HOST=127.0.0.1   # produção VPS (nginx na frente)
#
# Modo dono — números que falam com o RONALDO (status + ações em tasks)
# Vírgula-separado. Vazio/none = desliga. Se não definido, usa o Vitor padrão.
# OWNER_WA_IDS=5533999353242
#
# Canal operacional Vitor (autorizado — memoria/autorizacao_vitor_whatsapp.md)
VITOR_WHATSAPP_WA_ID=5533999353242
# VITOR_WHATSAPP_MODEL=gpt-4o-mini
# VITOR_WHATSAPP_MAX_TOKENS=900
# RONALDO_PATROL_MINUTES=30   # intervalo timer systemd na VPS
#
# Cadência de tasks (substitui teto rígido de WIP)
# TASK_CADENCE_MIN=10   # intervalo mínimo em min entre iniciar uma task e a próxima
# WIP_SOFT_MAX=0        # teto opcional de tasks simultâneas (0 = sem teto)
#
# Auditoria pós-conclusão Ronaldo (ronaldo-audit.timer, 10 min)
# AUDIT_LLM_MODEL=gpt-4o-mini   # modelo da auditoria; sem OPENAI_API_KEY cai em fallback heurístico
#
# Fase 0 — aprovação WhatsApp (mensagem proativa a cliente + gasto alto)
# APPROVAL_COST_THRESHOLD_USD=1.0   # ações acima disso pedem OK ao Vitor
#
# Templates Meta — abertura proativa (LP-PINTOR-006)
# Cadastrar em Meta Business → Message templates → nome exato abaixo
WHATSAPP_TEMPLATE_ABERTURA=abertura_pintor_contato
#
# Fase 1 — memória semântica (Supabase pwlpdpwxxhbsmkclrpoa — mesmo projeto VitorOS)
SUPABASE_URL=https://pwlpdpwxxhbsmkclrpoa.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend: Postgres direto (Settings → Database → connection string)
SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.pwlpdpwxxhbsmkclrpoa.supabase.co:5432/postgres
# Opcional: service role para APIs REST futuras (nunca no frontend)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
MEMORY_ENABLED=1
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
