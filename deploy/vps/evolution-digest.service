[Unit]
Description=Ronaldo — resumo diário autoevolução (Fase 4)
After=network-online.target laboratorio-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=laboratorio
Group=laboratorio
WorkingDirectory=/opt/laboratorio/Laboratorio/backend
Environment=PYTHONPATH=/opt/laboratorio/Laboratorio/backend/src
ExecStart=/opt/laboratorio/Laboratorio/backend/.venv/bin/python -m laboratorio evolution-digest
Nice=10

[Install]
WantedBy=multi-user.target
